{
    "name": "tiger/laravel-pos-backup",
    "description": "Automated MySQL database backups to private Amazon S3 bucket for POS applications.",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Tiger Team"
        }
    ],
    "require": {
        "php": "^8.0 || ^8.1 || ^8.2 || ^8.3",
        "illuminate/support": "^9.0 || ^10.0 || ^11.0",
        "illuminate/console": "^9.0 || ^10.0 || ^11.0",
        "aws/aws-sdk-php": "^3.200"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0 || ^8.0 || ^9.0",
        "phpunit/phpunit": "^9.5 || ^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Tiger\\PosBackup\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tiger\\PosBackup\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Tiger\\PosBackup\\TigerPosBackupServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
